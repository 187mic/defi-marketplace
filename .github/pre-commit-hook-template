#!/bin/sh
# Pre-commit hook to prevent committing sensitive information
# 
# To install this hook:
# 1. Copy this file to .git/hooks/pre-commit
# 2. Make it executable: chmod +x .git/hooks/pre-commit

# Color codes for output
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m' # No Color

echo "${YELLOW}🔍 Checking for sensitive information...${NC}"

# Check for .env files being committed
if git diff --cached --name-only | grep -E "^\.env$|^\.env\.local$|^\.env\.development$|^\.env\.production$"; then
  echo "${RED}❌ ERROR: Attempting to commit .env file!${NC}"
  echo "These files should never be committed as they contain secrets."
  echo "Please remove them from the commit:"
  echo "  git reset HEAD .env"
  exit 1
fi

# Check for potential API keys and secrets in code
CACHED_DIFF=$(git diff --cached)

# Check for common secret patterns
if echo "$CACHED_DIFF" | grep -iE "(api[_-]?key|secret|password|private[_-]?key|token).*[:=].*['\"][a-zA-Z0-9_-]{20,}['\"]"; then
  echo "${RED}❌ ERROR: Potential hardcoded secret detected!${NC}"
  echo "Found patterns that look like API keys or secrets in your changes."
  echo "Please use environment variables instead of hardcoding secrets."
  exit 1
fi

# Check for Alchemy/Infura API keys in URLs
if echo "$CACHED_DIFF" | grep -E "(alchemy\.com/v2/[a-zA-Z0-9_-]{20,}|infura\.io/v3/[a-zA-Z0-9_-]{20,})"; then
  echo "${RED}❌ ERROR: API key detected in URL!${NC}"
  echo "Found what appears to be a real API key in an RPC URL."
  echo "Please use environment variables and the .env file."
  exit 1
fi

# Check for private keys (64 hex characters after 0x)
if echo "$CACHED_DIFF" | grep -E "0x[a-fA-F0-9]{64}"; then
  echo "${RED}❌ WARNING: Potential private key detected!${NC}"
  echo "Found a pattern that looks like a private key."
  echo "If this is a real private key, DO NOT commit it!"
  echo "Press Ctrl+C to cancel, or Enter to continue anyway..."
  read -r response
fi

# Check git author email
AUTHOR_EMAIL=$(git config user.email)
if echo "$AUTHOR_EMAIL" | grep -E "@.*\.local$"; then
  echo "${YELLOW}⚠️  WARNING: Using local email address: $AUTHOR_EMAIL${NC}"
  echo "Consider using a public email or GitHub's no-reply email."
  echo "To change: git config user.email \"your-email@example.com\""
  echo ""
  echo "Press Ctrl+C to cancel, or Enter to continue anyway..."
  read -r response
fi

echo "${GREEN}✓ Pre-commit checks passed${NC}"
exit 0
